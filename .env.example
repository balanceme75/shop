# =====================================================================
# 초록마트 환경변수 — 양식 파일 (값 없음, GitHub 에 커밋됨)
#
# 사용법: 이 파일을 .env 로 복사한 뒤 실제 값을 채워 넣으세요.
#         .env 는 .gitignore 로 제외되어 GitHub 에 올라가지 않습니다.
#
#   Copy-Item .env.example .env
# =====================================================================

# --- 공개 값 (브라우저에 그대로 노출됨 / script.js 에도 들어있음) ---
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
SUPABASE_PROJECT_REF=<project-ref>

# --- 비공개 값 (절대 커밋·공유 금지) -----------------------------------
# 프로젝트 관리자 권한 토큰. 로컬에서 스키마 변경(Management API)에만 사용.
# 발급/폐기: https://supabase.com/dashboard/account/tokens
SUPABASE_PAT=sbp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
